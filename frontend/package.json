{
  "name": "civic-pulse-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts",
    "format:check": "prettier --check src tests *.ts *.js *.json index.html",
    "format": "prettier --write src tests *.ts *.js *.json index.html"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.8.0",
    "prettier": "3.6.2",
    "typescript": "^5.4.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
