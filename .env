# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=change-me-use-url-safe-chars
POSTGRES_DB=civicpulse
REDIS_PASSWORD=change-me-use-url-safe-chars

TRIAGE_PROVIDER=simulated        # simulated | llm | ollama | rules
GROQ_API_KEY=                    # from console.groq.com; leave empty unless TRIAGE_PROVIDER=llm
LLM_MODEL=llama-3.1-8b-instant   # check Groq's current model list
OLLAMA_MODEL=llama3.2:1b
OLLAMA_VERSION=0.5.7             # bump to the current release and keep it pinned
RATE_LIMIT_PER_MINUTE=10
FRONTEND_PORT=80

# compose.prod.yaml only
GITHUB_OWNER=your-github-username
IMAGE_TAG=                       # a commit SHA, never "latest"
